---
interface Props {
  title: string;
}

const { title } = Astro.props;
import Header from '../components/Header.astro';
import '@fontsource-variable/encode-sans';
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Portfolio of Fabián Andrés Urrutia, Systems Engineer focused on software development, automation, integrations and solution design."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <div class="pointer-glow" aria-hidden="true"></div>

    <div class="art-layer" aria-hidden="true">
      <span class="art-shape art-red"></span>
      <span class="art-shape art-purple"></span>
      <span class="art-shape art-green"></span>
      <span class="art-line art-line-one"></span>
      <span class="art-line art-line-two"></span>
      <span class="art-ring art-ring-one"></span>
    </div>

    <Header />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #ffffff;
    --ink: #111111;
    --muted: #626875;
    --line: #e8e8ea;
    --red: #b73f4a;
    --red-soft: #faecee;
    --green: #2f7d5a;
    --green-soft: #eaf5ef;
    --purple: #6847a8;
    --purple-soft: #f0ebf8;
    --black-soft: #f4f4f4;
  }

  * {
    box-sizing: border-box;
  }

  html {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    font-family: 'Encode Sans Variable', sans-serif;
    scroll-behavior: smooth;
    scroll-padding-top: 6.5rem;
    background: var(--paper);
  }

  html[data-lang="en"] .lang-es,
  html[data-lang="es"] .lang-en {
    display: none !important;
  }

  body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
    min-height: 100vh;
    margin: 0;
    overflow-x: clip;
    color: var(--ink);
    background:
      linear-gradient(rgba(255,255,255,.975), rgba(255,255,255,.975)),
      radial-gradient(circle at 1px 1px, rgba(17,17,17,.07) 1px, transparent 0);
    background-size: auto, 34px 34px;
  }

  .portfolio-main {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: clip;
  }

  main,
  header {
    position: relative;
    z-index: 2;
  }

  img,
  svg,
  video {
    max-width: 100%;
  }

  ::selection {
    color: #fff;
    background: var(--purple);
  }

  .scroll-progress {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    pointer-events: none;
    background: transparent;
  }

  .scroll-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, var(--red), var(--purple) 48%, var(--green));
    box-shadow: 0 0 12px rgba(104,71,168,.22);
    transition: width .08s linear;
  }

  .pointer-glow {
    position: fixed;
    z-index: 1;
    top: 0;
    left: 0;
    width: 22rem;
    height: 22rem;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle, rgba(104,71,168,.065), rgba(47,125,90,.025) 38%, transparent 70%);
    transform: translate3d(-50%, -50%, 0);
    transition: opacity .3s ease;
  }

  .art-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .art-shape,
  .art-line,
  .art-ring {
    position: absolute;
    display: block;
  }

  .art-shape {
    opacity: .105;
    animation: art-float 16s ease-in-out infinite alternate;
  }

  .art-red {
    top: 28%;
    left: -2rem;
    width: 5.5rem;
    height: 12rem;
    background: var(--red);
    clip-path: polygon(9% 5%, 93% 0, 76% 96%, 0 83%);
    transform: rotate(-7deg);
  }

  .art-purple {
    top: 4.5rem;
    right: -3rem;
    width: 13rem;
    height: 5rem;
    background: var(--purple);
    clip-path: polygon(4% 41%, 100% 0, 86% 74%, 0 100%);
    transform: rotate(-12deg);
    animation-delay: -5s;
  }

  .art-green {
    right: -2rem;
    bottom: 10%;
    width: 7.5rem;
    height: 13rem;
    background: var(--green);
    clip-path: polygon(17% 0, 100% 18%, 78% 100%, 0 81%);
    transform: rotate(9deg);
    animation-delay: -9s;
  }

  .art-line {
    width: 8rem;
    height: 8rem;
    border-left: 2px solid #111;
    border-top: 2px solid #111;
    opacity: .07;
  }

  .art-line-one {
    top: 43%;
    right: 3%;
    transform: rotate(19deg) skew(-8deg);
  }

  .art-line-two {
    left: 5%;
    bottom: 4%;
    width: 6rem;
    height: 5rem;
    transform: rotate(-17deg) skew(12deg);
  }

  .art-ring {
    left: 18%;
    top: 68%;
    width: 7rem;
    height: 7rem;
    border: 1.1rem solid var(--purple);
    opacity: .035;
    transform: rotate(14deg);
    animation: ring-drift 20s ease-in-out infinite alternate;
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border: 1px solid var(--line);
    border-radius: 9999px;
    padding: .38rem .68rem;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .14em;
    color: #4a4e57;
    background: rgba(255,255,255,.94);
    box-shadow: 0 6px 16px rgba(17,17,17,.025);
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity .68s cubic-bezier(.2,.75,.2,1), transform .68s cubic-bezier(.2,.75,.2,1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes art-float {
    0% { translate: 0 0; rotate: 0deg; }
    100% { translate: 0 18px; rotate: 2deg; }
  }

  @keyframes ring-drift {
    0% { transform: translateY(0) rotate(14deg); }
    100% { transform: translateY(-24px) rotate(22deg); }
  }

  @media (max-width: 767px) {
    html { scroll-padding-top: 5.4rem; }

    .pointer-glow { display: none; }

    .art-shape { opacity: .055; }
    .art-line { opacity: .04; }
    .art-ring { opacity: .025; }

    /* Mobile fallback: tall sections such as Projects must never remain invisible
       if an observer is delayed or the section is taller than the viewport. */
    .reveal {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    body:hover .pointer-glow { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }

    .art-shape,
    .art-ring { animation: none; }

    .reveal,
    .reveal.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    {
      /* A low threshold is important for mobile because sections such as
         Projects are taller than the viewport and can never reach 12%. */
      threshold: 0.01,
      rootMargin: '0px 0px -5% 0px'
    }
  );

  document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => revealObserver.observe(element));

  const progress = document.querySelector<HTMLElement>('.scroll-progress span');
  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    progress.style.width = `${value * 100}%`;
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);

  const glow = document.querySelector<HTMLElement>('.pointer-glow');
  if (glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    window.addEventListener('pointermove', (event) => {
      glow.style.left = `${event.clientX}px`;
      glow.style.top = `${event.clientY}px`;
    }, { passive: true });
  }

  const setPortfolioLanguage = (lang: string) => {
    const normalized = lang === 'es' ? 'es' : 'en';
    document.documentElement.dataset.lang = normalized;
    document.documentElement.lang = normalized;
    localStorage.setItem('portfolio-language', normalized);

    document.querySelectorAll<HTMLElement>('[data-lang-toggle]').forEach((button) => {
      const isActive = button.dataset.langToggle === normalized;
      button.classList.toggle('active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  };

  setPortfolioLanguage(localStorage.getItem('portfolio-language') || 'en');

  document.querySelectorAll<HTMLElement>('[data-lang-toggle]').forEach((button) => {
    button.addEventListener('click', () => setPortfolioLanguage(button.dataset.langToggle || 'en'));
  });
</script>
