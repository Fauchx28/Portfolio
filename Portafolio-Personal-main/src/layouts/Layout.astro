---
interface Props {
  title: string;
}

const { title } = Astro.props;
import Header from '../components/Header.astro';
import '@fontsource-variable/encode-sans';
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Portfolio of Fabián Andrés Urrutia, Systems Engineer focused on software development, automation, integrations and solution design."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="art-layer" aria-hidden="true">
      <span class="art-shape art-red"></span>
      <span class="art-shape art-purple"></span>
      <span class="art-shape art-green"></span>
      <span class="art-line art-line-one"></span>
      <span class="art-line art-line-two"></span>
    </div>
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #ffffff;
    --ink: #111111;
    --muted: #626875;
    --line: #e8e8ea;
    --red: #b73f4a;
    --red-soft: #faecee;
    --green: #2f7d5a;
    --green-soft: #eaf5ef;
    --purple: #6847a8;
    --purple-soft: #f0ebf8;
    --black-soft: #f4f4f4;
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: 'Encode Sans Variable', sans-serif;
    scroll-behavior: smooth;
    scroll-padding-top: 6.5rem;
    background: var(--paper);
  }

  html[data-lang="en"] .lang-es,
  html[data-lang="es"] .lang-en {
    display: none !important;
  }

  body {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
    color: var(--ink);
    background:
      linear-gradient(rgba(255,255,255,.97), rgba(255,255,255,.97)),
      radial-gradient(circle at 1px 1px, rgba(17,17,17,.075) 1px, transparent 0);
    background-size: auto, 34px 34px;
  }

  main,
  header {
    position: relative;
    z-index: 2;
  }

  ::selection {
    color: #fff;
    background: var(--purple);
  }

  .art-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .art-shape,
  .art-line {
    position: absolute;
    display: block;
    opacity: .12;
  }

  .art-red {
    top: 28%;
    left: -2rem;
    width: 5.5rem;
    height: 12rem;
    background: var(--red);
    clip-path: polygon(9% 5%, 93% 0, 76% 96%, 0 83%);
    transform: rotate(-7deg);
  }

  .art-purple {
    top: 4.5rem;
    right: -3rem;
    width: 13rem;
    height: 5rem;
    background: var(--purple);
    clip-path: polygon(4% 41%, 100% 0, 86% 74%, 0 100%);
    transform: rotate(-12deg);
  }

  .art-green {
    right: -2rem;
    bottom: 10%;
    width: 7.5rem;
    height: 13rem;
    background: var(--green);
    clip-path: polygon(17% 0, 100% 18%, 78% 100%, 0 81%);
    transform: rotate(9deg);
  }

  .art-line {
    width: 8rem;
    height: 8rem;
    border-left: 2px solid #111;
    border-top: 2px solid #111;
    opacity: .08;
  }

  .art-line-one {
    top: 43%;
    right: 3%;
    transform: rotate(19deg) skew(-8deg);
  }

  .art-line-two {
    left: 5%;
    bottom: 4%;
    width: 6rem;
    height: 5rem;
    transform: rotate(-17deg) skew(12deg);
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    border: 1px solid var(--line);
    border-radius: 9999px;
    padding: .38rem .68rem;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .14em;
    color: #4a4e57;
    background: rgba(255,255,255,.92);
  }

  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity .72s cubic-bezier(.2,.75,.2,1), transform .72s cubic-bezier(.2,.75,.2,1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal,
    .reveal.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));

  const setPortfolioLanguage = (lang: string) => {
    const normalized = lang === 'es' ? 'es' : 'en';
    document.documentElement.dataset.lang = normalized;
    document.documentElement.lang = normalized;
    localStorage.setItem('portfolio-language', normalized);

    document.querySelectorAll<HTMLElement>('[data-lang-toggle]').forEach((button) => {
      const isActive = button.dataset.langToggle === normalized;
      button.classList.toggle('active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  };

  setPortfolioLanguage(localStorage.getItem('portfolio-language') || 'en');

  document.querySelectorAll<HTMLElement>('[data-lang-toggle]').forEach((button) => {
    button.addEventListener('click', () => setPortfolioLanguage(button.dataset.langToggle || 'en'));
  });
</script>
