---
import data from "../items/data/projects.json";
---

<div class="reveal">
  <div class="projects-heading mb-10 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
    <div>
      <span class="section-eyebrow"><span class="lang-en">SELECTED WORK</span><span class="lang-es">TRABAJO SELECCIONADO</span></span>
      <h2 class="mt-3 text-4xl font-black tracking-tight text-gray-950 sm:text-6xl"><span class="lang-en">Projects</span><span class="lang-es">Proyectos</span></h2>
      <p class="lang-en mt-4 max-w-2xl text-gray-600">Professional software work alongside selected academic and personal projects.</p>
      <p class="lang-es mt-4 max-w-2xl text-gray-600">Trabajo profesional de software junto con proyectos académicos y personales seleccionados.</p>
    </div>

    <div class="flex flex-wrap gap-2" aria-label="Project filters">
      <button class="filter-btn active" type="button" data-filter="all"><span class="lang-en">All</span><span class="lang-es">Todos</span></button>
      <button class="filter-btn" type="button" data-filter="5ig"><span class="lang-en">5IG Client Work</span><span class="lang-es">Trabajo 5IG</span></button>
      <button class="filter-btn" type="button" data-filter="academic"><span class="lang-en">Academic & Personal</span><span class="lang-es">Académicos y Personales</span></button>
    </div>
  </div>

  <div class="projects-grid grid gap-7 md:grid-cols-2">
    {data.map((project) => (
      <article class:list={["project-card", project.featured && "featured-project"]} data-category={project.category}>
        <a class="project-media group" href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
          <img src={project.avatar} alt={project.name.en} loading="lazy" />
        </a>

        <div class="project-content">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            {project.category === '5ig' ? (
              <span class="client-badge"><span class="lang-en">5IG PROJECT</span><span class="lang-es">PROYECTO 5IG</span></span>
            ) : (
              <span class="client-badge academic-badge"><span class="lang-en">ACADEMIC / PERSONAL</span><span class="lang-es">ACADÉMICO / PERSONAL</span></span>
            )}
            <span class="project-subtitle"><span class="lang-en">{project.subtitle.en}</span><span class="lang-es">{project.subtitle.es}</span></span>
          </div>

          <h3 class="text-2xl font-bold text-gray-950"><span class="lang-en">{project.name.en}</span><span class="lang-es">{project.name.es}</span></h3>
          <p class="lang-en mt-2 leading-relaxed text-gray-600">{project.content.en}</p>
          <p class="lang-es mt-2 leading-relaxed text-gray-600">{project.content.es}</p>

          <ul class="project-details mt-4">
            {project.details.en.map((detail, index) => (
              <li><span class="lang-en">{detail}</span><span class="lang-es">{project.details.es[index]}</span></li>
            ))}
          </ul>

          <div class="mt-5 flex flex-wrap gap-2">
            {project.tech.map((tech) => <span class="tech-chip">{tech}</span>)}
          </div>

          <div class="mt-5 flex items-center justify-between gap-4">
            <span class="project-note"><span class="lang-en">{project.note.en}</span><span class="lang-es">{project.note.es}</span></span>
            <a class="project-link" href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <span class="lang-en">{project.linkLabel.en}</span><span class="lang-es">{project.linkLabel.es}</span> ↗
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .filter-btn {
    border: 1px solid #dedee2;
    border-radius: 9999px;
    padding: .56rem .9rem;
    font-size: .8rem;
    font-weight: 820;
    color: #646973;
    background: rgba(255,255,255,.94);
    transition: transform .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
  }

  .filter-btn:hover { transform: translateY(-2px); border-color: var(--purple); }
  .filter-btn.active { color: #fff; background: var(--ink); border-color: var(--ink); }

  .project-card {
    overflow: hidden;
    border: 1px solid #e7e7ea;
    border-radius: 1.15rem;
    background: rgba(255,255,255,.97);
    box-shadow: 0 14px 36px rgba(17,17,17,.05);
    transition: transform .32s cubic-bezier(.2,.75,.2,1), box-shadow .32s ease, border-color .32s ease;
  }

  .project-card:hover { transform: translateY(-6px); box-shadow: 0 26px 55px rgba(17,17,17,.1); border-color: #d4d4d8; }
  .project-card.is-hidden { display: none !important; }
  .featured-project { border-color: #dfd8ef; }

  .project-media {
    position: relative;
    display: block;
    height: 235px;
    overflow: hidden;
    background: #f4f4f4;
  }

  .project-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(17,17,17,.08), transparent 50%);
    pointer-events: none;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .55s cubic-bezier(.2,.75,.2,1), filter .45s ease;
  }

  .project-card:hover .project-media img { transform: scale(1.035); filter: saturate(.92) contrast(1.02); }

  .image-label {
    position: absolute;
    z-index: 2;
    right: .8rem;
    bottom: .8rem;
    border: 1px solid rgba(255,255,255,.75);
    border-radius: 9999px;
    padding: .34rem .55rem;
    font-size: .58rem;
    font-weight: 900;
    letter-spacing: .11em;
    color: var(--ink);
    background: rgba(255,255,255,.9);
    backdrop-filter: blur(8px);
  }

  .project-content { padding: 1.3rem; }

  .client-badge {
    border-radius: 9999px;
    padding: .32rem .52rem;
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .08em;
    color: #5a3b91;
    background: var(--purple-soft);
  }

  .academic-badge { color: #2b684c; background: var(--green-soft); }
  .project-subtitle { font-size: .73rem; font-weight: 760; color: #858a94; }

  .project-details {
    display: grid;
    gap: .42rem;
    padding-left: 1rem;
    color: #646a75;
    font-size: .87rem;
    line-height: 1.5;
  }

  .project-details li::marker { color: var(--red); }

  .tech-chip {
    border: 1px solid #e4e4e7;
    border-radius: 9999px;
    padding: .32rem .52rem;
    font-size: .68rem;
    font-weight: 780;
    color: #4e535d;
    background: #fafafa;
  }

  .project-note { font-size: .69rem; font-weight: 650; color: #9a9ea6; }
  .project-link { flex-shrink: 0; font-size: .8rem; font-weight: 900; color: var(--purple); transition: transform .2s ease, color .2s ease; }
  .project-link:hover { transform: translate(2px,-2px); color: var(--red); }

  @media (min-width: 768px) {
    .featured-project:first-child {
      grid-column: span 2;
      display: grid;
      grid-template-columns: .95fr 1.05fr;
    }

    /* Important: prevents the first 5IG card from leaking into Academic & Personal. */
    .featured-project:first-child.is-hidden { display: none !important; }
    .featured-project:first-child .project-media { height: 100%; min-height: 355px; }
  }
</style>

<script>
  const filterButtons = [...document.querySelectorAll<HTMLElement>('.filter-btn')];
  const projectCards = [...document.querySelectorAll<HTMLElement>('.project-card')];

  const applyFilter = (filter: string) => {
    filterButtons.forEach((item) => item.classList.toggle('active', item.dataset.filter === filter));
    projectCards.forEach((card) => {
      const show = filter === 'all' || card.dataset.category === filter;
      card.classList.toggle('is-hidden', !show);
      card.setAttribute('aria-hidden', String(!show));
    });
  };

  filterButtons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter || 'all')));
  applyFilter('all');
</script>
