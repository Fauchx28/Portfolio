<header class="portfolio-header">
  <div class="header-shell">
    <nav class="nav-shell" aria-label="Portfolio navigation">
      <a class="nav-link" href="#about"><span class="lang-en">About</span><span class="lang-es">Inicio</span></a>
      <a class="nav-link" href="#exp"><span class="lang-en">Experience</span><span class="lang-es">Experiencia</span></a>
      <a class="nav-link" href="#projects"><span class="lang-en">Projects</span><span class="lang-es">Proyectos</span></a>
      <a class="nav-link" href="#tech"><span class="lang-en">Tech</span><span class="lang-es">Tecnologías</span></a>
      <a class="nav-link" href="#certifications"><span class="lang-en">Certifications</span><span class="lang-es">Certificaciones</span></a>
      <a class="nav-link" href="#contact"><span class="lang-en">Contact</span><span class="lang-es">Contacto</span></a>
    </nav>

    <div class="language-switcher" aria-label="Language switcher / selector de idioma">
      <button class="lang-btn active" data-lang-toggle="en" type="button" aria-pressed="true">EN</button>
      <button class="lang-btn" data-lang-toggle="es" type="button" aria-pressed="false">ES</button>
    </div>
  </div>
</header>

<style>
  .portfolio-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    padding: .9rem .8rem;
    pointer-events: none;
  }

  .header-shell {
    display: flex;
    width: min(100%, 72rem);
    min-width: 0;
    margin: 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    pointer-events: auto;
  }

  .nav-shell {
    display: flex;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    gap: .15rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border: 1px solid rgba(17,17,17,.08);
    border-radius: 9999px;
    padding: .42rem;
    background: rgba(255,255,255,.88);
    box-shadow: 0 12px 36px rgba(17,17,17,.06);
    backdrop-filter: blur(18px) saturate(1.15);
  }

  .nav-shell::-webkit-scrollbar { display: none; }

  .nav-link {
    position: relative;
    flex-shrink: 0;
    white-space: nowrap;
    border-radius: 9999px;
    padding: .58rem .82rem;
    font-size: .82rem;
    font-weight: 760;
    color: #565b66;
    transition: color .22s ease, background-color .22s ease, transform .22s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: .18rem;
    width: 0;
    height: 2px;
    border-radius: 99px;
    background: var(--purple);
    transform: translateX(-50%);
    transition: width .22s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--ink);
    background: var(--purple-soft);
    transform: translateY(-1px);
  }

  .nav-link:hover::after,
  .nav-link.active::after { width: 1.15rem; }

  .language-switcher {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: .2rem;
    border: 1px solid var(--line);
    border-radius: 9999px;
    padding: .3rem;
    background: rgba(255,255,255,.94);
    box-shadow: 0 10px 28px rgba(17,17,17,.055);
    backdrop-filter: blur(14px);
  }

  .lang-btn {
    border: none;
    border-radius: 9999px;
    padding: .5rem .66rem;
    font-size: .73rem;
    font-weight: 900;
    letter-spacing: .08em;
    color: #6c7078;
    background: transparent;
    cursor: pointer;
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }

  .lang-btn:hover { transform: translateY(-1px); }
  .lang-btn.active { color: #fff; background: var(--ink); }

  @media (max-width: 767px) {
    .portfolio-header {
      padding: .55rem .55rem .7rem;
    }

    .header-shell {
      flex-direction: row;
      overflow: hidden;
      gap: .45rem;
    }

    .nav-shell {
      flex: 1 1 auto;
      width: 0;
      max-width: none;
      padding: .32rem;
    }

    .nav-link {
      padding: .5rem .68rem;
      font-size: .75rem;
    }

    .language-switcher {
      flex: 0 0 auto;
      padding: .25rem;
    }

    .lang-btn {
      padding: .46rem .55rem;
      font-size: .68rem;
    }
  }

  @media (min-width: 768px) {
    .nav-link { padding-inline: .92rem; font-size: .88rem; }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav-link')];
  const sections = links
    .map((link) => document.querySelector(link.getAttribute('href') ?? ''))
    .filter((section): section is Element => section !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

      if (!visible) return;
      links.forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${visible.target.id}`));
    },
    { rootMargin: '-22% 0px -66% 0px', threshold: [0, .05, .15] }
  );

  sections.forEach((section) => observer.observe(section));
</script>
